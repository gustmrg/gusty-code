# git autocrlf=true converts LF to CRLF on Windows, causing issues with oxfmt
* text=auto eol=lf
# Batch files need CRLF for cmd.exe to parse them reliably.
*.cmd text eol=crlf
*.bat text eol=crlf
# GitHub's, Linear's and Expo's GraphQL schemas and the operations graphqlgen writes from them.
packages/source-control-github/schema/** linguist-generated
packages/issue-tracker-linear/schema/** linguist-generated
apps/server/schema/** linguist-generated
**/*.graphql.ts linguist-generated
# Keep Gusty Code's versions on upstream syncs; AGENTS.md changes are ported by hand. Needs `git config merge.ours.driver true`.
README.md merge=ours
AGENTS.md merge=ours
.github/workflows/ci.yml merge=ours
.github/workflows/release.yml merge=ours
# A no-op stand-in for upstream's analytics service; Gusty Code sends no product analytics.
apps/server/src/telemetry/AnalyticsService.ts merge=ours
